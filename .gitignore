# macOS / editor noise
.DS_Store
.vscode/
.playwright/

# Python
__pycache__/
*.pyc

# R session artifacts
.Rhistory
.RData

# Excel lock files
~$*.xlsx

# Manual backup copies (superseded by git history; old ones archived in
# /Users/nika/nika_cursor2_archive/)
*.backup_*

# Per-sync provenance logs — large and regenerated by every sync run.
# The latest pair is kept on disk; older ones live in the archive zip.
App_py/data/google_sheets_sync_sources_*.csv
App_py/data/google_sheets_sync_skips_*.csv

# Local Claude Code settings
.claude/settings.local.json

# Raw Drive export dropped inside Google Sheets/2026/ on 2 Oct 2026. These are
# duplicates of the 2026 workbooks under their Drive names; the sync only reads
# "Google Sheets/<year>/*.xlsx", so it never looks at them. Kept on disk,
# untracked, so git history does not carry a second copy of every workbook.
Google Sheets/*/drive-download-*/
